# Copy this file to ".env" (Windows: copy .env.example .env) and fill it in. Never share or commit ".env".
# All values below are PLACEHOLDERS — replace them with your own.

# --- required -------------------------------------------------------------
# PostgreSQL connection string. Create the empty database first (README, step 4).
# Replace YOUR_PASSWORD with the password you chose for the "postgres" user.
# Special characters in the password must be percent-encoded: @ -> %40, # -> %23, / -> %2F, : -> %3A
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/ridex

# --- first administrator (choose ONE way; both are off while empty) ---------
# A) one-time setup page at /admin/setup. Use any long random text (20+ characters).
ADMIN_SETUP_CODE=

# B) or seed the first admin automatically on first start (password: 10+ characters)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- maps (optional; the free public demo servers are used by default, no key needed) ----
# Identify your deployment to the public Nominatim service, e.g. "RideX/1.0 (you@example.com)"
# NOMINATIM_USER_AGENT=
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OSRM_BASE_URL=https://router.project-osrm.org
